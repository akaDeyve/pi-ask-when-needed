{
  "name": "pi-ask-when-needed",
  "version": "0.1.1-alpha",
  "description": "Pi extension: asks for confirmation only for dangerous actions (rm -rf, sudo, git push, publishing, secrets) and lets everything else through.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "permissions",
    "confirmation",
    "safety",
    "guard"
  ],
  "files": [
    "src",
    "docs",
    "README.md",
    "README.de.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node tests/matchers.mjs",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
